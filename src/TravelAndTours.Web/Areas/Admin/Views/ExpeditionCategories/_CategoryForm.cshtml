@model TravelAndTours.Web.Models.ExpeditionCategoryEditViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="mb-3">
    <label class="form-label">Name</label>
    <input asp-for="Category.Name" class="form-control" />
    <span asp-validation-for="Category.Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label class="form-label">Slug</label>
    <input asp-for="Category.Slug" class="form-control" />
    <span asp-validation-for="Category.Slug" class="text-danger"></span>
</div>

<div class="mb-3">
    <label class="form-label">Parent Category</label>
    <select asp-for="Category.ParentCategoryId" class="form-select">
        <option value="">None</option>
        @foreach (var option in Model.ParentOptions)
        {
            <option value="@option.Id">@option.Name</option>
        }
    </select>
    <span asp-validation-for="Category.ParentCategoryId" class="text-danger"></span>
</div>

<div class="mb-3">
    <label class="form-label">Sort Order</label>
    <input asp-for="Category.SortOrder" class="form-control" />
    <span asp-validation-for="Category.SortOrder" class="text-danger"></span>
</div>

<div class="form-check mb-3">
    <input asp-for="Category.IsActive" class="form-check-input" />
    <label class="form-check-label" asp-for="Category.IsActive">Active</label>
</div>
