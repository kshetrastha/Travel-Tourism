@model List<TravelAndTours.Web.Models.ProductDto>
@{
    ViewData["Title"] = "Admin - Products";
}

<div class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-2 mb-4">
        <div>
            <h2 class="fw-semibold mb-1">Manage Packages</h2>
            <div class="text-white-50">Admin only</div>
        </div>
        <a class="btn btn-primary" asp-area="Admin" asp-controller="Products" asp-action="Create">Add package</a>
    </div>

    <div class="card card-tt">
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <div class="text-white-50">No packages yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width:80px">Id</th>
                                <th>Name</th>
                                <th style="width:140px">Price</th>
                                <th style="width:160px">Created</th>
                                <th style="width:180px"></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.Name</td>
                                <td>$@item.Price</td>
                                <td>@item.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">
                                    <a class="btn btn-outline-light btn-sm" asp-area="Admin" asp-controller="Products" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                                    <form asp-area="Admin" asp-controller="Products" asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-outline-danger btn-sm" type="submit" onclick="return confirm('Delete this package?')">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
