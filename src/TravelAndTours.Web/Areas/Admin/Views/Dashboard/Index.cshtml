@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
    ViewData["PageTitle"] = "Dashboard";
    ViewData["PageSubTitle"] = "Overview";
}

<div class="container-fluid">
    <div class="card dashboard-hero shadow-sm">
        <div class="card-body">
            <div class="row align-items-center gy-3">
                <div class="col-12 col-lg-8">
                    <h2 class="mb-2">Welcome back, admin!</h2>
                    <p class="text-muted mb-0">
                        Manage expeditions, packages, and upcoming departures from your dashboard.
                    </p>
                </div>
                <div class="col-12 col-lg-4 text-center text-lg-end">
                    <img src="~/assets/images/logo-icon.png" alt="TravelAndTours" class="dashboard-hero-image" />
                </div>
            </div>
        </div>
    </div>
</div>
