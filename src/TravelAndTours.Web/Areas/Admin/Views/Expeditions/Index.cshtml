@model List<TravelAndTours.Web.Models.AdminExpeditionListItemDto>
@{
    ViewData["Title"] = "Admin - Expeditions";
}

<div class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-2 mb-4">
        <div>
            <h2 class="fw-semibold mb-1">Manage Expeditions</h2>
            <div class="text-white-50">Admin only</div>
        </div>
        <a class="btn btn-primary" asp-area="Admin" asp-controller="Expeditions" asp-action="Create">Add expedition</a>
    </div>

    <div class="card card-tt">
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <div class="text-white-50">No expeditions yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width:80px">Id</th>
                                <th>Title</th>
                                <th style="width:160px">Category</th>
                                <th style="width:140px">Status</th>
                                <th style="width:160px">Created</th>
                                <th style="width:120px"></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>
                                    <div class="fw-semibold">@item.Title</div>
                                    <div class="text-white-50 small">@item.Slug</div>
                                </td>
                                <td>@item.CategoryName</td>
                                <td>@item.Status</td>
                                <td>@item.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">
                                    <a class="btn btn-outline-light btn-sm" asp-area="Admin" asp-controller="Expeditions" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
