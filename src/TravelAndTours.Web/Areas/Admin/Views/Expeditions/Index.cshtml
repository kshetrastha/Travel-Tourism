@model TravelAndTours.Web.Models.AdminExpeditionsIndexViewModel
@{
    ViewData["Title"] = "Admin - Expeditions";
    var paged = Model.Expeditions;
    var startItem = paged.TotalCount == 0 ? 0 : ((paged.Page - 1) * paged.PageSize) + 1;
    var endItem = paged.TotalCount == 0 ? 0 : Math.Min(paged.Page * paged.PageSize, paged.TotalCount);
}

<div class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-2 mb-4">
        <div>
            <h2 class="fw-semibold mb-1">Manage Expeditions</h2>
            <div class="text-white-50">Admin only</div>
        </div>
        <a class="btn btn-primary" asp-area="Admin" asp-controller="Expeditions" asp-action="Create">Add expedition</a>
    </div>

    <div class="card card-tt">
        <div class="card-body">
            @if (paged.Items.Count == 0)
            {
                <div class="text-white-50">No expeditions yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width:80px">Id</th>
                                <th>Title</th>
                                <th style="width:160px">Category</th>
                                <th style="width:140px">Status</th>
                                <th style="width:160px">Created</th>
                                <th style="width:120px"></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in paged.Items)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>
                                    <div class="fw-semibold">@item.Title</div>
                                    <div class="text-white-50 small">@item.Slug</div>
                                </td>
                                <td>@item.CategoryName</td>
                                <td>@item.Status</td>
                                <td>@item.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">
                                    <a class="btn btn-outline-light btn-sm" asp-area="Admin" asp-controller="Expeditions" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mt-3">
                    <div class="text-white-50 small">
                        Showing @startItem-@endItem of @paged.TotalCount
                    </div>
                    @if (paged.TotalPages > 1)
                    {
                        <nav aria-label="Expedition pagination">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(paged.Page <= 1 ? "disabled" : string.Empty)">
                                    <a class="page-link" asp-area="Admin" asp-controller="Expeditions" asp-action="Index" asp-route-page="@(paged.Page - 1)">
                                        Previous
                                    </a>
                                </li>
                                @for (var i = 1; i <= paged.TotalPages; i++)
                                {
                                    <li class="page-item @(i == paged.Page ? "active" : string.Empty)">
                                        <a class="page-link" asp-area="Admin" asp-controller="Expeditions" asp-action="Index" asp-route-page="@i">@i</a>
                                    </li>
                                }
                                <li class="page-item @(paged.Page >= paged.TotalPages ? "disabled" : string.Empty)">
                                    <a class="page-link" asp-area="Admin" asp-controller="Expeditions" asp-action="Index" asp-route-page="@(paged.Page + 1)">
                                        Next
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            }
        </div>
    </div>
</div>
