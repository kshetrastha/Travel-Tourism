@model TravelAndTours.Web.Models.ExpeditionCreateViewModel
@{
    ViewData["Title"] = "Admin - Create Expedition";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-semibold mb-1">Create Expedition</h2>
            <div class="text-white-50">Start with the core details, facts, and variants.</div>
        </div>
        <a class="btn btn-outline-light" asp-area="Admin" asp-controller="Expeditions" asp-action="Index">Back to list</a>
    </div>

    <form method="post">
        @Html.AntiForgeryToken()
        <div class="text-danger mb-3">@Html.ValidationSummary()</div>
        @await Html.PartialAsync("_ExpeditionBaseFields", Model.Expedition, new ViewDataDictionary(ViewData) { ["Categories"] = Model.Categories })
        <div class="d-flex justify-content-end gap-2">
            <button class="btn btn-primary" type="submit">Create expedition</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
