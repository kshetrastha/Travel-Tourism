@model List<TravelAndTours.Web.Models.ProductDto>
@{
    ViewData["Title"] = "Packages";
}

<div class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-2 mb-4">
        <div>
            <h2 class="fw-semibold mb-1">Tour Packages</h2>
            <div class="text-white-50">Loaded from TravelAndTours.Api (/api/products)</div>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-dark border-0">No packages found. Add some as Admin.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card card-tt h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="fw-semibold">@item.Name</div>
                                    <div class="text-white-50 small">Created @item.CreatedAt.ToString("yyyy-MM-dd")</div>
                                </div>
                                <span class="badge-soft">$@item.Price</span>
                            </div>
                            <div class="mt-3 text-white-50">This is a placeholder description. Replace with your real package fields.</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
