@using TravelAndTours.Web.Services
@using Microsoft.AspNetCore.Http
@{
    var isSignedIn = !string.IsNullOrWhiteSpace(Context.Session.GetString(SessionKeys.AccessToken));
    var userName = Context.Session.GetString(SessionKeys.UserName) ?? Context.Session.GetString(SessionKeys.UserEmail);
    var roles = (Context.Session.GetString(SessionKeys.UserRoles) ?? "");
    var isAdmin = roles.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Any(r => string.Equals(r, "Admin", StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Travel & Tours</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">TravelAndTours</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMain">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index">Packages</a></li>
                        @if (isAdmin)
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Products" asp-action="Index">Admin</a></li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (!isSignedIn)
                        {
                            <a class="btn btn-outline-light btn-sm" asp-controller="Auth" asp-action="Login">Login</a>
                            <a class="btn btn-primary btn-sm" asp-controller="Auth" asp-action="Register">Sign up</a>
                        }
                        else
                        {
                            <div class="text-white-50 small">Hi, <span class="text-white">@userName</span></div>
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-outline-light btn-sm" type="submit">Logout</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="border-top py-4 mt-5">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
            <div class="text-muted">© @DateTime.UtcNow.Year TravelAndTours</div>
            <div class="text-muted">Frontend for TravelAndTours.Api</div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
