@{
    ViewData["Title"] = "Home";
}

<!-- Hero section -->
<section class="w-full h-[100vh] relative overflow-hidden">
    <!-- Swiper -->
    <div class="swiper mySwiper w-full h-full">
        <div class="swiper-wrapper">

            <!-- Slide item -->
            <div class="swiper-slide">
                <div class="w-full h-full relative">
                    <img src="./assets/img/hero/hero1.jpg" alt="hero img"
                         class="w-full h-full object-cover">

                    <!-- Overlay Content -->
                    <div class="absolute inset-0 bg-black/50 flex flex-col justify-center
                               px-6 sm:px-10 md:px-20 lg:px-28 xl:px-36">

                        <h1 data-aos="fade-left" data-aos-duration="1000" class="text-[32px] sm:text-[40px] md:text-[50px] lg:text-[60px] xl:text-[64px]
                                   font-bold uppercase text-[#e1a74e] leading-tight max-w-[650px] mb-4">
                            Mt. Everest I Exped.
                        </h1>

                        <p data-aos="fade-left" data-aos-duration="1100"
                           class="text-base sm:text-lg md:text-xl text-neutral-50 max-w-[600px] mb-6">
                            Expedition to the highest peak on the world, scheduled for April - May (Spring)
                            2025
                        </p>

                        <a data-aos="fade-left" data-aos-duration="1200" href="#" class="flex items-center gap-4 text-base md:text-lg font-normal text-neutral-50
                                  hover:text-[#e1a74e] transition duration-300 group">
                            <div class="w-9 h-9 rounded-full bg-neutral-200 flex items-center justify-center
                                        group-hover:bg-[#e1a74e] group-hover:translate-x-2 transition duration-300">
                                <i class="fa-solid fa-chevron-right text-[#e1a74e] text-sm
                                          group-hover:text-neutral-50"></i>
                            </div>
                            <span>Learn More</span>
                        </a>

                    </div>
                </div>
            </div>

            <div class="swiper-slide">
                <div class="w-full h-full relative">
                    <img src="./assets/img/hero/hero2.png" class="w-full h-full object-cover" />

                    <div class="absolute inset-0 bg-black/50 flex flex-col justify-center
                                px-6 sm:px-10 md:px-20 lg:px-28 xl:px-36">

                        <h1 data-aos="fade-left" data-aos-duration="1000" class="text-[32px] sm:text-[40px] md:text-[50px] lg:text-[60px] xl:text-[64px]
                                   font-bold uppercase text-[#e1a74e] leading-tight max-w-[650px] mb-4">
                            MT. KANGCHENJUNGA EXPED.
                        </h1>

                        <p data-aos="fade-left" data-aos-duration="1100"
                           class="text-base sm:text-lg md:text-xl text-neutral-50 max-w-[600px] mb-6">
                            Expedition to the third highest mountain in the world, scheduled for April - May
                            (Spring) 2025
                        </p>

                        <a data-aos="fade-left" data-aos-duration="1200" href="#" class="flex items-center gap-4 text-base md:text-lg text-neutral-50 hover:text-[#e1a74e]
                                  transition duration-300 group">
                            <div class="w-9 h-9 rounded-full bg-neutral-200 flex items-center justify-center
                                        transition duration-300 group-hover:bg-[#e1a74e] group-hover:translate-x-2">
                                <i class="fa-solid fa-chevron-right text-[#e1a74e] text-sm
                                          group-hover:text-neutral-50"></i>
                            </div>
                            <span>Learn more about this expedition</span>
                        </a>

                    </div>
                </div>
            </div>

            <div class="swiper-slide">
                <div class="w-full relative h-full">
                    <img src="./assets/img/hero/hero3.png" alt="hero img"
                         class="w-full h-full object-cover object-center">

                    <!-- absolute overlays content -->
                    <div class="w-full h-full absolute top-0 left-0 bg-black/50 md:px-39 sm:px-20 px-4 flex items-start flex-col justify-center">
                        <h1 data-aos="fade-left" data-aos-duration="1000" class="text-[32px] sm:text-[40px] md:text-[50px] lg:text-[60px] xl:text-[64px]
                                   font-bold uppercase text-[#e1a74e] leading-tight max-w-[650px] mb-4">
                            MT. LHOTSE EXPED.
                        </h1>
                        <p data-aos="fade-left" data-aos-duration="1100"
                           class="text-base sm:text-lg md:text-xl text-neutral-50 max-w-[600px] mb-6">
                            Expedition to the fourth highest mountain in the world, scheduled for April -
                            May (Spring) 2025
                        </p>
                        <a data-aos="fade-left" data-aos-duration="1200" href="#" class="flex items-center gap-4 text-base md:text-lg text-neutral-50 hover:text-[#e1a74e]
                                  transition duration-300 group">
                            <div class="w-9 h-9 rounded-full bg-neutral-200 flex items-center justify-center
                                        transition duration-300 group-hover:bg-[#e1a74e] group-hover:translate-x-2">
                                <i class="fa-solid fa-chevron-right text-[#e1a74e] text-sm
                                          group-hover:text-neutral-50"></i>
                            </div>
                            <span>Learn More</span>
                        </a>
                    </div>
                </div>
            </div>

            <div class="swiper-slide">
                <div class="w-full relative h-full">
                    <img src="./assets/img/hero/hero4.png" alt="hero img"
                         class="w-full h-full object-cover object-center">

                    <!-- absolute overlays content -->
                    <div class="w-full h-full absolute top-0 left-0 bg-black/50 md:px-39 sm:px-20 px-4 flex items-start flex-col justify-center">
                        <h1 data-aos="fade-left" data-aos-duration="1000" class="text-[32px] sm:text-[40px] md:text-[50px] lg:text-[60px] xl:text-[64px]
                                   font-bold uppercase text-[#e1a74e] leading-tight max-w-[650px] mb-4">
                            EVEREST BASECAMP TREK
                        </h1>
                        <p data-aos="fade-left" data-aos-duration="1100"
                           class="text-base sm:text-lg md:text-xl text-neutral-50 max-w-[600px] mb-6">
                            Embark on the ultimate adventure to Everest Basecamp and witness the
                            breathtaking beauty of the world's highest peaks - scheduled for Autumn 2025.
                        </p>
                        <a data-aos="fade-left" data-aos-duration="1200" href="#" class="flex items-center gap-4 text-base md:text-lg text-neutral-50 hover:text-[#e1a74e]
                                  transition duration-300 group">
                            <div class="w-9 h-9 rounded-full bg-neutral-200 flex items-center justify-center
                                        transition duration-300 group-hover:bg-[#e1a74e] group-hover:translate-x-2">
                                <i class="fa-solid fa-chevron-right text-[#e1a74e] text-sm
                                          group-hover:text-neutral-50"></i>
                            </div>
                            <span>Learn more</span>
                        </a>
                    </div>
                </div>
            </div>

            <div class="swiper-slide">
                <div class="w-full relative h-full">
                    <img src="./assets/img/hero/hero5.png" alt="hero img"
                         class="w-full h-full object-cover object-center">

                    <!-- absolute overlays content -->
                    <div class="w-full h-full absolute top-0 left-0 bg-black/50 md:px-39 sm:px-20 px-4 flex items-start flex-col justify-center">
                        <h1 data-aos="fade-left" data-aos-duration="1000" class="text-[32px] sm:text-[40px] md:text-[50px] lg:text-[60px] xl:text-[64px]
                                   font-bold uppercase text-[#e1a74e] leading-tight max-w-[650px] mb-4">
                            MT. MAKALU EXPED.
                        </h1>
                        <p data-aos="fade-left" data-aos-duration="1100"
                           class="text-base sm:text-lg md:text-xl text-neutral-50 max-w-[600px] mb-6">
                            Expedition to the fifth highest mountain in the world, scheduled for April - May
                            (Spring) 2025
                        </p>
                        <a data-aos="fade-left" data-aos-duration="1200" href="#" class="flex items-center gap-4 text-base md:text-lg text-neutral-50 hover:text-[#e1a74e]
                                  transition duration-300 group">
                            <div class="w-9 h-9 rounded-full bg-neutral-200 flex items-center justify-center
                                        transition duration-300 group-hover:bg-[#e1a74e] group-hover:translate-x-2">
                                <i class="fa-solid fa-chevron-right text-[#e1a74e] text-sm
                                          group-hover:text-neutral-50"></i>
                            </div>
                            <span>Explore</span>
                        </a>
                    </div>
                </div>
            </div>

            <div class="swiper-slide">
                <div class="w-full relative h-full">
                    <img src="~/cassets/img/hero/hero6.png" alt="hero img"
                         class="w-full h-full object-cover object-center">

                    <!-- absolute overlays content -->
                    <div class="w-full h-full absolute top-0 left-0 bg-black/50 md:px-39 sm:px-20 px-4 flex items-start flex-col justify-center">
                        <h1 data-aos="fade-left" data-aos-duration="1000" class="text-[32px] sm:text-[40px] md:text-[50px] lg:text-[60px] xl:text-[64px]
                                   font-bold uppercase text-[#e1a74e] leading-tight max-w-[650px] mb-4">
                            MT. ANNAPURNA I EXPED.
                        </h1>
                        <p data-aos="fade-left" data-aos-duration="1100"
                           class="text-base sm:text-lg md:text-xl text-neutral-50 max-w-[600px] mb-6">
                            Known for the difficulty and danger involved during the ascent, scheduled for 18
                            March 2025 - 28 April 2025 (Spring).
                        </p>
                        <a data-aos="fade-left" data-aos-duration="1200" href="#" class="flex items-center gap-4 text-base md:text-lg text-neutral-50 hover:text-[#e1a74e]
                                  transition duration-300 group">
                            <div class="w-9 h-9 rounded-full bg-neutral-200 flex items-center justify-center
                                        transition duration-300 group-hover:bg-[#e1a74e] group-hover:translate-x-2">
                                <i class="fa-solid fa-chevron-right text-[#e1a74e] text-sm
                                          group-hover:text-neutral-50"></i>
                            </div>
                            <span>Explore here</span>
                        </a>
                    </div>
                </div>
            </div>

        </div>

        <!-- Navigation -->
        <div class="swiper-button-next !text-3xl right-4">
            <i class="fas fa-chevron-right text-[#e1a74e]"></i>
        </div>
        <div class="swiper-button-prev !text-3xl left-4">
            <i class="fas fa-chevron-left text-[#e1a74e]"></i>
        </div>

        <!-- Pagination -->
        <div class="swiper-pagination"></div>
    </div>
</section>

<section class="hero">
    <div class="container hero-inner">
        <p class="badge-soft mb-3">Nepal • Himalayas • Luxury</p>
        <h1 class="display-6 fw-bold mb-3">Plan your next trip with TravelAndTours</h1>
        <p class="lead text-white-50 mb-4">Explore curated tour packages, expeditions, and VIP services. Browse packages and book through your backend API.</p>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary" asp-controller="Products" asp-action="Index">Browse packages</a>
            <a class="btn btn-outline-light" asp-controller="Auth" asp-action="Register">Create account</a>
        </div>

        <div class="row g-3 mt-4">
            <div class="col-md-4">
                <div class="card card-tt">
                    <div class="card-body">
                        <div class="fw-semibold">Trusted operators</div>
                        <div class="text-white-50">Built for real tour businesses, not a demo UI.</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-tt">
                    <div class="card-body">
                        <div class="fw-semibold">Fast search</div>
                        <div class="text-white-50">List and filter packages powered by TravelAndTours.Api.</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-tt">
                    <div class="card-body">
                        <div class="fw-semibold">Admin CRUD</div>
                        <div class="text-white-50">Manage packages securely with role-based access.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
