@model TravelAndTours.Web.Models.HomeIndexViewModel
@{
    ViewData["Title"] = "Home";
    var featured = Model.FeaturedExpeditions;
}

<section class="hero">
    <div class="container hero-inner">
        <p class="badge-soft mb-3">Nepal • Himalayas • Luxury</p>
        <h1 class="display-6 fw-bold mb-3">Plan your next trip with TravelAndTours</h1>
        <p class="lead text-white-50 mb-4">Explore curated tour packages, expeditions, and VIP services. Browse packages and book through your backend API.</p>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary" asp-controller="Products" asp-action="Index">Browse packages</a>
            <a class="btn btn-outline-light" asp-controller="Auth" asp-action="Register">Create account</a>
        </div>

        <div class="row g-3 mt-4">
            <div class="col-md-4">
                <div class="card card-tt">
                    <div class="card-body">
                        <div class="fw-semibold">Trusted operators</div>
                        <div class="text-white-50">Built for real tour businesses, not a demo UI.</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-tt">
                    <div class="card-body">
                        <div class="fw-semibold">Fast search</div>
                        <div class="text-white-50">List and filter packages powered by TravelAndTours.Api.</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-tt">
                    <div class="card-body">
                        <div class="fw-semibold">Admin CRUD</div>
                        <div class="text-white-50">Manage packages securely with role-based access.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-2 mb-4">
            <div>
                <h2 class="fw-semibold mb-1">Featured expeditions</h2>
                <div class="text-white-50">Handpicked adventures from our latest listings.</div>
            </div>
            <a class="btn btn-outline-light btn-sm" asp-controller="Expeditions" asp-action="Index">See all expeditions</a>
        </div>

        @if (featured.Items.Count == 0)
        {
            <div class="alert alert-dark border-0">Expedition highlights are coming soon.</div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var item in featured.Items)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card card-tt h-100">
                            @if (!string.IsNullOrWhiteSpace(item.CoverImageUrl))
                            {
                                <img class="card-img-top" src="@item.CoverImageUrl" alt="@item.Title" />
                            }
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="fw-semibold">@item.Title</div>
                                        <div class="text-white-50 small">@item.Region, @item.Country</div>
                                    </div>
                                    @if (item.PriceFrom.HasValue)
                                    {
                                        <span class="badge-soft">$@item.PriceFrom.Value</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.Tagline))
                                {
                                    <div class="mt-2 text-white-50 small">@item.Tagline</div>
                                }
                                <div class="mt-3 text-white-50 small">
                                    <div>Duration: @item.DurationDays days</div>
                                    <div>Difficulty: @item.Difficulty</div>
                                    <div>Best season: @item.BestSeason</div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
